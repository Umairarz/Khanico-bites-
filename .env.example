# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/khanico_bites?schema=public
# Hosted (e.g. Neon/Supabase/Railway) example given by your provider
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/khanico_bites?schema=public"

# Secret used to sign customer + admin JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Public site URL (used in metadata / SEO tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number customers reach you on, digits only with country code (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Seed-only: initial admin account created by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@khanicobites.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
