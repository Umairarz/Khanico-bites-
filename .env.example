# --- Supabase example ---
# DATABASE_URL = pooled connection (port 6543, via PgBouncer) — used by the app at runtime
# DIRECT_URL   = direct connection (port 5432) — used only when running migrations
# Both are found in Supabase: Project Settings → Database → Connection string
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Secret used to sign customer + admin JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"

# Public site URL (used in metadata / SEO tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number customers reach you on, digits only with country code (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# Seed-only: initial admin account created by prisma/seed.ts
SEED_ADMIN_EMAIL="admin@khanicobites.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
